# ============================================================
# AYAMONTE AL DÍA - Variables de entorno (ejemplo)
# Copia este archivo a `.env` y rellena los valores.
# NUNCA subas el archivo .env a un repositorio.
# ============================================================

# --- Servidor ---
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# --- Ruta de la base de datos SQLite ---
DB_PATH=data/ayamonte.db

# --- Panel de administración (obligatorio cambiar en producción) ---
ADMIN_USER=admin
ADMIN_PASSWORD=CambiaEstaClave123!
# Secreto para firmar cookies de sesión (cadena aleatoria larga)
SESSION_SECRET=pon-aqui-una-cadena-aleatoria-larga-y-unica

# --- Frecuencia de búsqueda automática (minutos) ---
# 0 desactiva la búsqueda automática. Por defecto: 30
AUTO_COLLECT_MINUTES=30

# --- Publicación: auto (publica sin revisión) | manual (requiere aprobación) ---
# Por defecto: manual
PUBLICATION_MODE=manual

# ============================================================
# PROVEEDOR DE BÚSQUEDA WEB (opcional)
# Proveedor soportado: none | serper | brave | serpapi | generic
# Si es "none", solo se utilizan las fuentes RSS.
# ============================================================
SEARCH_PROVIDER=none
SEARCH_API_KEY=
# Para "generic": endpoint propio que acepta ?q=&num= y devuelve JSON
SEARCH_API_URL=

# ============================================================
# PROVEEDOR DE INTELIGENCIA ARTIFICIAL (opcional)
# Proveedor soportado: none | openai | openrouter | anthropic | generic
# Si es "none", se aplica un procesador local por reglas
# (clasificación y resumen extractivo, sin inventar contenido).
# ============================================================
AI_PROVIDER=none
AI_API_KEY=
# URL base (por defecto la del proveedor si se deja vacío)
AI_API_URL=
AI_MODEL=


# --- Búsquedas temáticas (separadas por coma) ---
SEARCH_QUERIES=Ayamonte,Ayamonte Huelva,Semana Santa Ayamonte,Carnaval Ayamonte,Ayuntamiento de Ayamonte
